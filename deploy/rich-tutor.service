[Unit]
Description=Rich Tutor Flask/Gunicorn
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/rich-tutor
Environment="PATH=/home/ubuntu/rich-tutor/.venv/bin"
Environment="RICH_TUTOR_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
ExecStart=/home/ubuntu/rich-tutor/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5055 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
