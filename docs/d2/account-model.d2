direction: right

admin: {
  label: "Administrator"
  shape: person
}

invite: {
  label: "Invite Link"
}

manual: {
  label: "Admin-Created\nAccount"
}

temporary: {
  label: "Temporary Password"
}

forced: {
  label: "Forced Password\nChange"
}

student: {
  label: "Student Account"
}

parent: {
  label: "Parent Account"
}

relationship: {
  label: "parent_students"
  shape: sql_table

  parent_id: "parent_id"
  student_id: "student_id"
}

