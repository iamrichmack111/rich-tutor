}

admin -> manual
admin -> invite

manual -> temporary
temporary -> forced
forced -> student
forced -> parent

invite -> student: "student invite"
invite -> parent: "parent invite"

parent -> relationship
relationship -> student

student -> progress
parent -> progress: "read linked records"
admin -> progress: "administration/reporting"
